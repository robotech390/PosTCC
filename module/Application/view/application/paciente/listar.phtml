<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Exclusão</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Você tem certeza que deseja excluir este paciente?
                <p class="text-danger mt-2">Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a href="#" id="btn-confirm-delete" class="btn btn-danger">Confirmar Exclusão</a>
            </div>
        </div>
    </div>
</div>

<audio id="notification-sound" src="/sound/sound.mp3" preload="auto"></audio>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const deleteModalElement = document.getElementById('deleteConfirmModal');
        const confirmDeleteBtn = document.getElementById('btn-confirm-delete');
        const deleteModal = new bootstrap.Modal(deleteModalElement);
        const notificationSound = document.getElementById('notification-sound');
        let lastData = null;

        document.body.addEventListener('click', function (event) {
            const deleteButton = event.target.closest('.btn-delete-paciente');

            if (deleteButton) {
                event.preventDefault();

                const deleteUrl = deleteButton.getAttribute('href');
                confirmDeleteBtn.setAttribute('href', deleteUrl);
                deleteModal.show();
            }
        });

        confirmDeleteBtn.addEventListener('click', function (event) {
            event.preventDefault();
            window.location.href = this.getAttribute('href');
        });

        function fetchUpdates() {
            fetch('<?= $this->url('paciente', ['action' => 'verificar-atualizacoes']) ?>')
                .then(response => response.json())
                .then(data => {
                    const dataString = JSON.stringify(data);

                    // Verifica se houve mudanças nos dados
                    if (lastData && lastData !== dataString) {
                        notificationSound.play();
                    }

                    updateDashboard(data);
                    lastData = dataString;
                })
                .catch(error => console.error('Erro ao verificar atualizações:', error));
        }

        function updateDashboard(pacientes) {
            const container = document.querySelector('.row');
            container.innerHTML = '';

            if (pacientes.length === 0) {
                container.innerHTML = `
                    <div class="col-12">
                        <div class="alert alert-info">
                            Nenhum paciente cadastrado ainda.
                        </div>
                    </div>
                `;
            } else {
                pacientes.forEach(paciente => {
                    console.log(paciente)
                    const badgeClass = paciente.status && paciente.status.evento === "1" ? 'bg-success' : 'bg-primary';
                    const statusText = paciente.status && paciente.status.evento === "1" ? 'Acordado' : 'Dormindo';
                    const dataRegistro = paciente.status ? paciente.status.dataRegistro : 'N/A';

                    const card = `
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="text-center mb-3">
                                        <img src="/uploads/${paciente.foto || 'default_img.jpeg'}"
                                             alt="Foto de ${paciente.nome}"
                                             class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;">
                                    </div>
                                    <h5 class="card-title text-center">${paciente.nome}</h5>
                                    <span class="badge ${badgeClass}">${statusText}</span>
                                    <p class="text-muted text-center mt-2">Última atualização: ${dataRegistro}</p>
                                    <ul class="list-unstyled text-muted mt-2 mb-4">
                                        <li><strong>CPF:</strong> ${paciente.cpf}</li>
                                        <li><strong>Telefone:</strong> ${paciente.telefone}</li>
                                    </ul>

                                    <div class="mt-auto">
                                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                                            <a href="/paciente/historico/${paciente.id}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-file"></i> Histórico Pessoal
                                            </a>
                                            <a href="/paciente/editar/${paciente.id}" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <a href="/paciente/excluir/${paciente.id}" class="btn btn-sm btn-outline-danger btn-delete-paciente">
                                                <i class="fas fa-trash"></i> Excluir
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    container.innerHTML += card;
                });
            }
        }

        fetchUpdates();

        setInterval(fetchUpdates, 5000);

    });
</script>