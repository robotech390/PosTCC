                             class="patient-photo"
                             onerror="this.src='/uploads/default_img.jpeg'">
                        <div class="patient-info">
                            <div class="patient-top">
                                <div class="patient-name">
                                    <h2>${escapeHtml(patient.name)}</h2>
                                    <p>Quarto ${escapeHtml(patient.room)}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="patient-details">
                        <div class="detail-row" style="flex-direction: column; align-items: center; text-align: center; padding: 1.5rem 0;">
                            <span style="font-size: 2.5rem; font-weight: 700; color: var(--report-color-dark); bottom: 0.5rem;">
                                ${escapeHtml(patient.totalTime)}
                            </span>
                            <span style="font-size: 1.125rem; color: #6b7280;">
                                Tempo desperto durante este período
                            </span>
                        </div>
                        <a href="${detailsUrl}" class="btn-details" target="_blank">
                            <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            Ver Detalhes
                        </a>
                    </div>
                </div>
            `;
        }

        function createInactiveCard(patient) {
            const detailsUrl = `/paciente/historico/${patient.id}? start_date=${startDate}&end_date=${endDate}`;

            return `
            <div class="patient-card inactive-card">
                <div class="patient-header">
                    <img src="${escapeHtml(patient.photo)}"
                         alt="${escapeHtml(patient.name)}"
                         class="patient-photo"
                         onerror="this.src='/uploads/default_img.jpeg'">
                    <div class="patient-info">
                        <div class="patient-top">
                            <div class="patient-name">
                                <h2>${escapeHtml(patient.name)}</h2>
                                <p>Quarto ${escapeHtml(patient. room)}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="patient-details">
                    <div class="inactive-message">
                        <svg class="inactive-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                        </svg>
                        <p class="inactive-text">Sem registro neste período</p>
                        ${patient.lastActivity ? `<p class="last-activity">Última atividade: ${escapeHtml(patient.lastActivity)}</p>` : ''}
                    </div>
                    <a href="${detailsUrl}" class="btn-details" target="_blank">
                        <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        Ver Detalhes
                    </a>
                </div>
            </div>
        `;
        }

        function renderPagination() {
            const totalPages = Math.ceil(allPatients.length / itemsPerPage);
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = Math.min(startIndex + itemsPerPage, allPatients.length);

            paginationInfo.textContent = `Mostrando ${startIndex + 1} - ${endIndex} de ${allPatients.length} pacientes`;

            let buttonsHTML = '';

            if (currentPage > 1) {
                buttonsHTML += `
                    <button class="pagination-btn" onclick="goToPage(${currentPage - 1})">
                        <svg style="width:  1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>
                `;
            } else {
                buttonsHTML += `
                    <button class="pagination-btn" disabled>
                        <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>
                `;
            }

            for (let page = 1; page <= totalPages; page++) {
                const activeClass = page === currentPage ? 'active' : '';
                buttonsHTML += `
                    <button class="pagination-number ${activeClass}" onclick="goToPage(${page})">
                        ${page}
                    </button>
                `;
            }

            if (currentPage < totalPages) {
                buttonsHTML += `
                    <button class="pagination-btn" onclick="goToPage(${currentPage + 1})">
                        <svg style="width:  1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                `;
            } else {
                buttonsHTML += `
                    <button class="pagination-btn" disabled>
                        <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                `;
            }

            paginationButtons.innerHTML = buttonsHTML;
        }

        function goToPage(page) {
            currentPage = page;
            renderPatients();
            renderPagination();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showLoading() {
            btnSearch.disabled = true;
            btnText.textContent = 'Carregando...';
            loadingState.classList.remove('hidden');
            resultsContainer.classList.add('hidden');
            emptyState.classList.add('hidden');
            hideError();
        }

        function hideLoading() {
            btnSearch.disabled = false;
            btnText.textContent = 'Pesquisar';
            loadingState.classList.add('hidden');
        }

        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.classList.remove('hidden');
        }

        function hideError() {
            errorMessage.classList.add('hidden');
        }

        function showEmptyResults() {
            resultsContainer.classList.add('hidden');
            emptyState.classList.remove('hidden');

            const messages = {
                'frequencia': {
                    title: 'Nenhum despertar encontrado',
                    text: 'Não foram encontrados despertares no período selecionado'
                },
                'tempo':  {
                    title: 'Nenhum registro encontrado',
                    text: 'Não foram encontrados pacientes com tempo desperto no período'
                },
                'inatividade': {
                    title: 'Todos os pacientes ativos! ',
                    text: 'Todos os pacientes possuem registro de atividade no período selecionado'
                }
            };

            const currentMessage = messages[reportType];

            emptyState.innerHTML = `
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h2>${currentMessage.title}</h2>
            <p>${currentMessage. text}</p>
        `;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>