<style>
        .reports-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        @media (min-width: 768px) {
            .reports-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 1024px) {
            .reports-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .report-card {
            background-color: white;
            border-radius: 0.5rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            padding: 2rem;
            text-align:  left;
            transition: all 0.3s;
            cursor: pointer;
            border: none;
            width: 100%;
            display: flex;
            flex-direction: column;
            text-decoration: none;
        }

        .report-card:hover {
            box-shadow:  0 20px 25px -5px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .icon-container {
            width: 4rem;
            height: 4rem;
            border-radius:  0.5rem;
            display: flex;
            align-items:  center;
            justify-content:  center;
            margin-bottom:  1.5rem;
            transition: transform 0.3s;
        }

        .report-card:hover .icon-container {
            transform: scale(1.1);
        }

        .icon {
            width: 2rem;
            height: 2rem;
        }

        .report-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
            color: #1f2937;
        }

        .report-description {
            color: #6b7280;
            margin-bottom: 1.5rem;
            line-height: 1.5;
            flex-grow: 1;
        }

        .report-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1rem;
            border-top: 1px solid #e5e7eb;
        }

        .report-link {
            font-weight: 500;
        }

        .report-card:hover .report-link {
            text-decoration: underline;
        }

        .chevron-icon {
            width: 1.25rem;
            height: 1.25rem;
            transition: transform 0.3s;
        }

        .report-card:hover .chevron-icon {
            transform: translateX(0.25rem);
        }

        .bg-blue { background-color: #dbeafe; }
        .text-blue { color: #2563eb; }
        .hover-blue:hover { border-left: 4px solid #2563eb; }

        .bg-green { background-color: #d1fae5; }
        .text-green { color: #059669; }
        .hover-green:hover { border-left:  4px solid #059669; }

        .bg-purple { background-color: #e9d5ff; }
        .text-purple { color: #7c3aed; }
        .hover-purple:hover { border-left: 4px solid #7c3aed; }

        .bg-orange { background-color: #fed7aa; }
        .text-orange { color: #ea580c; }
        .hover-orange:hover { border-left: 4px solid #ea580c; }

        .bg-red { background-color: #fecaca; }
        .text-red { color: #dc2626; }
        .hover-red:hover { border-left: 4px solid #dc2626; }

        .bg-indigo { background-color: #c7d2fe; }
        .text-indigo { color: #4f46e5; }
        .hover-indigo:hover { border-left: 4px solid #4f46e5; }
</style>

<div class="reports-grid" id="reportsContainer"></div>

<script>
    // Dados dos relatórios - fácil de adaptar
    const reports = [
        {
            title: 'Relatório de Tempo Desperto',
            description: 'Visualize informações detalhadas sobre quais pacientes permaneceram mais tempo despertos',
            colorClass: 'blue',
            svgPath: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
            url:"tempo-desperto"
        },
        {
            title:  'Relatório de Frequência de Despertos',
            description: 'Consulte quais pacientes estão despertando mais frequentemente',
            colorClass: 'green',
            svgPath: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z',
            url:"frequencia-desperto"
        },
        {
            title:  'Relatório de Negligência de Uso',
            description: 'Acompanhe pacientes que não estão utilizando o dispositivo conforme recomendado',
            colorClass: 'purple',
            svgPath: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
            url:"negacao-uso"
        },
    ];

    // Função para criar os cards dinamicamente
    function renderReports() {
        const container = document.getElementById('reportsContainer');

        reports.forEach(report => {
            const card = `
                    <a class="report-card hover-${report.colorClass}" href="/relatorios/${report.url}">
                        <div class="icon-container bg-${report.colorClass}">
                            <svg class="icon text-${report.colorClass}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${report.svgPath}" />
                            </svg>
                        </div>
                        <h2 class="report-title">${report.title}</h2>
                        <p class="report-description">${report.description}</p>
                        <div class="report-footer">
                            <span class="report-link text-${report.colorClass}">Acessar relatório</span>
                            <svg class="chevron-icon text-${report.colorClass}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>
                    </a>
                `;

            container.innerHTML += card;
        });
    }
    renderReports();
</script>
